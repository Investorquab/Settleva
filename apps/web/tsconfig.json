{
  "compilerOptions":{
    "target":"ES2022","lib":["dom","dom.iterable","es2022"],"allowJs":false,"skipLibCheck":true,
    "strict":true,"noEmit":true,"esModuleInterop":true,"module":"esnext","moduleResolution":"bundler",
    "resolveJsonModule":true,"isolatedModules":true,"jsx":"preserve","incremental":true,
    "baseUrl":"../..",
    "paths":{
      "@settleva/conditions":["packages/conditions/src/index.ts"],
      "@settleva/sdk":["packages/sdk/src/index.ts"],
      "@settleva/providers":["packages/providers/src/index.ts"],
      "@settleva/verification":["packages/verification/src/index.ts"]
    },
    "plugins":[{"name":"next"}]
  },
  "include":["next-env.d.ts","**/*.ts","**/*.tsx",".next/types/**/*.ts"],
  "exclude":["node_modules"]
}
