# Settleva web/backend runtime configuration.
# Copy to .env.production for the local mainnet preflight.
# Blank values are intentional; configure real values in a secure environment.
# Never commit .env.production or expose server secrets through NEXT_PUBLIC_*.

NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_CHAIN_ID=5042
SETTLEVA_CHAIN_ID=5042
NEXT_PUBLIC_GITHUB_REPOSITORY=Investorquab/Settleva

NEXT_PUBLIC_SETTLEVA_ADDRESS=
SETTLEVA_CONTRACT_ADDRESS=
SETTLEVA_VERIFIER_PRIVATE_KEY=

RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_PROVIDER_ID=
RECLAIM_PROVIDER_VERSION=
NEXT_PUBLIC_RECLAIM_PROVIDER_ID=
NEXT_PUBLIC_RECLAIM_PROVIDER_VERSION=
RECLAIM_CALLBACK_URL=

DATABASE_URL=
