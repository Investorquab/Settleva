# Settleva web/backend runtime configuration.
# Copy to .env.production for local preflight. Blank values must be configured in a secure host.
# Never commit .env.production or expose server secrets through NEXT_PUBLIC_*.

NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_CHAIN_ID=5042
SETTLEVA_CHAIN_ID=5042
NEXT_PUBLIC_GITHUB_REPOSITORY=Investorquab/Settleva

NEXT_PUBLIC_SETTLEVA_ADDRESS=
SETTLEVA_CONTRACT_ADDRESS=
SETTLEVA_VERIFIER_PRIVATE_KEY=

RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_PROVIDER_ID=
RECLAIM_PROVIDER_VERSION=
NEXT_PUBLIC_RECLAIM_PROVIDER_ID=
NEXT_PUBLIC_RECLAIM_PROVIDER_VERSION=
RECLAIM_CALLBACK_URL=

DATABASE_URL=

# Optional provider-neutral Reclaim adapter registry. Leave [] until every source-specific Reclaim
# provider is published, pinned and validated against its authoritative event source.
SETTLEVA_RECLAIM_ADAPTERS=[]

# Optional source-to-server Ed25519 evidence. Register only authoritative source PUBLIC keys.
# Source private keys belong in source-server secret management, never here or in the browser.
# See docs/SIGNED_EVIDENCE_PROVIDERS.md.
SETTLEVA_SIGNED_EVIDENCE_ADAPTERS=[]
