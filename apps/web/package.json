{
  "name": "@settleva/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "check": "tsc --noEmit --rootDir ../..",
    "test": "node --test && node --check scripts/mainnet-preflight.mjs && node --check scripts/migrate-db.mjs",
    "build": "next build",
    "db:migrate": "node --env-file-if-exists=.env.production scripts/migrate-db.mjs",
    "preflight:mainnet": "node --env-file-if-exists=.env.production scripts/mainnet-preflight.mjs"
  },
  "dependencies": {
    "@settleva/conditions": "workspace:*",
    "@settleva/sdk": "workspace:*",
    "@settleva/providers": "workspace:*",
    "viem": "^2.37.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@settleva/verification": "workspace:*",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  }
}
